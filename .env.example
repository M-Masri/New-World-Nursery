# Backend origin only (no /api). Used by Vite proxy in npm run dev / preview.
VITE_API_ORIGIN=https://neworld-backend.sawatech.ae

# Browser API base (no trailing slash).
#
# Development (.env):
#   VITE_API_BASE_URL=/api
#   → requests go through Vite proxy to VITE_API_ORIGIN
#
# Production (.env.production / Vercel):
#   VITE_API_BASE_URL=https://neworld-backend.sawatech.ae/api
#   → browser calls the backend directly (Vercel has no /api proxy)
VITE_API_BASE_URL=/api
